# Copy this file to .env for local use and fill in your own values.
# Never commit the real .env file. It is listed in .gitignore.

# PostgreSQL connection string (for example from a free Neon project)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# The one account allowed to sign in
AUTH_USERNAME=choose-a-username
AUTH_PASSWORD=choose-a-strong-password

# Long random string used to sign login tokens.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=paste-a-long-random-string

# Optional. Comma-separated websites allowed to call the API.
# Leave unset locally to allow any; set it to the frontend address in production.
ALLOWED_ORIGINS=*

# Optional. Turns on the AI-written explanation under each score.
# Get a key at https://aistudio.google.com/apikey. Without it, the app uses
# its built-in explanation.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite
